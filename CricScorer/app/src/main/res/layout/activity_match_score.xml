<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activities.MatchScoreActivity">

    <TextView
        android:id="@+id/current_bowler_ms"
        android:layout_width="121dp"
        android:layout_height="72dp"
        android:layout_marginTop="12dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/scorer_text_view"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.375"
        app:layout_constraintStart_toEndOf="@+id/striker_name_ms"
        app:layout_constraintTop_toBottomOf="@+id/current_over_details_ms" />

    <TextView
        android:id="@+id/non_striker_name_ms"
        android:layout_width="250dp"
        android:layout_height="37dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/players_playing_string"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.084"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/striker_name_ms" />

    <TextView
        android:id="@+id/striker_name_ms"
        android:layout_width="250dp"
        android:layout_height="37dp"
        android:layout_marginTop="12dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/players_playing_string"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.084"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/current_over_details_ms" />

    <TextView
        android:id="@+id/current_over_details_ms"
        android:layout_width="377dp"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/players_playing_string"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.47"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/overs_value_ms" />

    <TextView
        android:id="@+id/run_rate_ms"
        android:layout_width="99dp"
        android:layout_height="44dp"
        android:layout_marginTop="48dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/scorer_text_view"
        android:textAlignment="center"
        android:textSize="16sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.377"
        app:layout_constraintStart_toEndOf="@+id/overs_value_ms"
        app:layout_constraintTop_toBottomOf="@+id/team_name_ms" />

    <TextView
        android:id="@+id/overs_value_ms"
        android:layout_width="73dp"
        android:layout_height="44dp"
        android:layout_marginTop="48dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/scorer_text_view"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@+id/score_value_ms"
        app:layout_constraintTop_toBottomOf="@+id/team_name_ms" />

    <TextView
        android:id="@+id/score_value_ms"
        android:layout_width="147dp"
        android:layout_height="65dp"
        android:layout_marginTop="32dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/scorer_text_view"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.116"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/team_name_ms" />

    <TextView
        android:id="@+id/team_name_ms"
        android:layout_width="377dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/players_playing_string"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scorer_text_view12" />

    <TextView
        android:id="@+id/scorer_text_view12"
        android:layout_width="214dp"
        android:layout_height="52dp"
        android:layout_marginTop="40dp"
        android:background="#E7EBEF"
        android:fontFamily="cursive"
        android:text="@string/scorer_text_view"
        android:textAlignment="center"
        android:textSize="34sp"
        android:textStyle="bold|italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.604"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/button9"
        android:layout_width="98dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:onClick="handleHomeClick"
        android:text="Home"
        app:layout_constraintEnd_toStartOf="@+id/scorer_text_view12"
        app:layout_constraintHorizontal_bias="0.358"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>